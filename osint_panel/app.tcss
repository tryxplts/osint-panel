Screen {
    background: #080b12;
    color: #d8e0ed;
}

#shell {
    height: 1fr;
    padding: 0 2;
}

#brand {
    height: 3;
    content-align: left middle;
    color: #7de2d1;
    text-style: bold;
}

#status {
    height: 3;
    content-align: right middle;
    color: #f6c85f;
    text-style: bold;
}

#tabs {
    height: 1fr;
}

#username-input, #target-input {
    height: 3;
}

#search-row, #target-row, #quick-actions {
    height: 3;
    margin-bottom: 1;
}

#scope-select {
    width: 28;
}

#tor-toggle {
    width: 8;
    padding: 1 1;
}

.grow {
    width: 1fr;
}

.eyebrow {
    color: #7de2d1;
    text-style: bold;
    margin-top: 1;
}

.hero {
    color: #ffffff;
    text-style: bold;
    margin-top: 1;
}

.panel-title {
    color: #f6c85f;
    text-style: bold;
    margin-bottom: 1;
}

.body-copy {
    color: #a9b5c8;
    margin: 1 0;
}

.muted {
    color: #72809a;
    margin: 1 0;
}

#stat-grid {
    height: 9;
    margin-top: 2;
}

.stat-card {
    width: 1fr;
    border: solid #26344d;
    padding: 1 2;
    color: #a9b5c8;
    margin-right: 1;
}

DataTable {
    height: 1fr;
    border: solid #26344d;
    background: #0d1420;
}

#username-results, #target-results, #history-results {
    margin-top: 1;
}

#settings-body, #install-help {
    border: solid #26344d;
    padding: 2;
    margin-top: 1;
}
